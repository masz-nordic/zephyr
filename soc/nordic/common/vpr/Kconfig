config RISCV_CORE_NORDIC_VPR
	bool
	select RISCV
	select RISCV_PRIVILEGED
	select RISCV_VECTORED_MODE
	select RISCV_ISA_RV32E
	select RISCV_ISA_EXT_M
	select RISCV_ISA_EXT_C
	select RISCV_ISA_EXT_ZICSR
	select RISCV_SOC_HAS_ISR_STACKING
	select RISCV_SOC_HAS_GP_RELATIVE_ADDRESSING
	select RISCV_HAS_CLIC
	select RISCV_SOC_CONTEXT_SAVE
	select HAS_FLASH_LOAD_OFFSET
	select ARCH_HAS_CUSTOM_CPU_IDLE if !SOC_SERIES_NRF54LX
	select ARCH_HAS_CUSTOM_CPU_ATOMIC_IDLE if !SOC_SERIES_NRF54LX
	select INCLUDE_RESET_VECTOR
	imply XIP
	help
	  Enable support for the RISC-V Nordic VPR core.

if RISCV_CORE_NORDIC_VPR

DEEP_SLEEP_PROP := nordic,deep-sleep-retain

config RISCV_CORE_NORDIC_VPR_DEEP_SLEEP
	bool "Enable deep sleep"
	depends on $(dt_nodelabel_bool_prop,cpu,$(DEEP_SLEEP_PROP))
	help
	  Enter deep sleep mode instead of sleep mode.

endif
